<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Permagent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- App Transport Security.

	     This dict previously set NSAllowsArbitraryLoads AND NSAllowsLocalNetworking
	     together, which does NOT mean "allow everything". From iOS 10, a granular
	     subkey takes precedence and the blanket NSAllowsArbitraryLoads is IGNORED —
	     so the effective policy was local-networking-only. A tailnet hub is neither:
	     Tailscale addresses live in the CGNAT range (100.64.0.0/10), not RFC1918,
	     and MagicDNS names end in .ts.net, not .local. So cleartext HTTP to the hub
	     was refused, surfacing on the phone as "blocked as insecure (TLS)".

	     The fix is a scoped exception for ts.net rather than re-enabling arbitrary
	     loads: the tailnet is already WireGuard-encrypted end to end, so HTTP over
	     it is not plaintext on the wire, and every other host stays under full ATS.
	     NSAllowsArbitraryLoads is dropped entirely — it was inert here and is a
	     needless App Store review flag.

	     If Tailscale HTTPS certs are enabled (admin console → DNS → HTTPS
	     Certificates), Serve moves to 443 with a real cert and this exception can
	     be deleted outright. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Permagent uses the camera to scan the pairing QR code displayed on your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Permagent connects to your Permagent hub on your local network or tailnet.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Permagent uses the microphone to dictate notes and talk with Henry.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
