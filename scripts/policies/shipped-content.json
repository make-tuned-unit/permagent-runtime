{
  "version": 1,
  "scope": {
    "roots": [
      "crates/*/src",
      "crates/goose/assets",
      "ui/command-center/src",
      "ui/command-center/public",
      "ui/desktop/src-tauri"
    ],
    "extensions": [
      ".rs",
      ".ts",
      ".tsx",
      ".md",
      ".yaml",
      ".yml",
      ".toml",
      ".json",
      ".html"
    ],
    "skipDirectories": [
      "node_modules",
      "dist",
      "target",
      "vendor",
      ".git",
      "gen"
    ],
    "skipFiles": [
      "crates/goose/src/providers/canonical/data/**",
      "crates/goose/src/dictation/whisper_data/**",
      "**/*.snap"
    ]
  },
  "rules": [
    {
      "id": "operational-home-root",
      "kind": "operationalLiteral",
      "include": [
        "crates/goose/src/prompts/**",
        "crates/goose-server/src/automation/**",
        "crates/goose-cli/src/recipes/**",
        "crates/goose/src/agents/builtin_skills/skills/**",
        "crates/goose-mcp/src/tutorial/tutorials/**",
        "crates/goose-server/src/app_catalog/**"
      ],
      "match": {
        "type": "regex",
        "pattern": "/Users/|/home/|~/Documents/dev|~/dev|\\$HOME/dev",
        "flags": ""
      },
      "message": "Resolve operational roots from configuration or discovery."
    },
    {
      "id": "projects-tool-home-guess",
      "kind": "operationalLiteral",
      "include": [
        "crates/goose/src/projects.rs"
      ],
      "match": {
        "type": "regex",
        "pattern": "~/Documents/dev|~/dev\\b",
        "flags": ""
      },
      "message": "Tool errors must not steer the model toward a hardcoded code root; point it at the configured dev roots."
    },
    {
      "id": "unsupported-machine-topology",
      "kind": "unsupportedClaim",
      "include": [
        "crates/goose/src/prompts/**",
        "crates/goose-server/src/automation/**",
        "crates/goose-cli/src/recipes/**",
        "crates/goose/src/agents/builtin_skills/skills/**",
        "crates/goose-mcp/src/tutorial/tutorials/**",
        "crates/goose-server/src/app_catalog/**",
        "crates/goose/src/meeting_writeup.rs"
      ],
      "match": {
        "type": "context",
        "anchor": {
          "type": "regex",
          "pattern": "\\b(?:your\\s+Mac\\s+mini|your\\s+tailnet)\\b",
          "flags": "i"
        },
        "window": {
          "linesBefore": 1,
          "linesAfter": 1
        },
        "requireAll": [
          {
            "type": "regex",
            "pattern": "\\b(?:written|processed|running|hosted)\\b",
            "flags": "i"
          }
        ],
        "rejectAny": []
      },
      "message": "Hardware ownership and network provenance require runtime evidence."
    },
    {
      "id": "legacy-agent-alias",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "match": {
        "type": "regex",
        "pattern": "\\bHank\\b|HankConversation|henry-malcolm",
        "flags": ""
      },
      "message": "Legacy agent alias: use the persona name or a neutral label."
    },
    {
      "id": "developer-wallet",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "match": {
        "type": "regex",
        "pattern": "0x[0-9a-fA-F]{40}",
        "flags": ""
      },
      "message": "Wallet/contract addresses belong in user config, not source."
    },
    {
      "id": "developer-did",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "exclude": [
        "ui/command-center/src/services/identity.ts"
      ],
      "match": {
        "type": "regex",
        "pattern": "did:chitin:",
        "flags": ""
      },
      "message": "On-chain identity is opt-in config; no DID literal in source."
    },
    {
      "id": "developer-places-projects",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "match": {
        "type": "regex",
        "pattern": "Halifax|Nova Scotia|Kinrows|Evntally|GetLadle|Atlas ?Atlantic|CityCircle|Pibye|Plekk|Lauft|Sharratt",
        "flags": ""
      },
      "message": "A developer's place, project or surname is a personal preference: use a neutral example. (Publisher metadata in the Tauri manifest and signing identity is excluded: it names the publisher, not a user preference.)",
      "exclude": [
        "ui/desktop/src-tauri/tauri.conf.json",
        "ui/desktop/src-tauri/Cargo.toml"
      ]
    },
    {
      "id": "personal-hosts-ids",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "match": {
        "type": "regex",
        "pattern": "jessesharratt|jesses-mac|[A-Za-z0-9-]+\\.tail[0-9a-f]+\\.ts\\.net|Z58XSBM78S|mini\\.local",
        "flags": ""
      },
      "message": "Personal host or account id: read it from config or use an example host.",
      "exclude": [
        "ui/desktop/src-tauri/tauri.conf.json",
        "ui/desktop/src-tauri/Cargo.toml"
      ]
    },
    {
      "id": "telemetry-key",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "match": {
        "type": "regex",
        "pattern": "phc_[A-Za-z0-9]{20,}",
        "flags": ""
      },
      "message": "Third-party telemetry keys must come from config, not source."
    },
    {
      "id": "regional-merchant-rules",
      "kind": "operationalLiteral",
      "include": [
        "**/*finance*",
        "**/*finance*/**",
        "**/*merchant*",
        "**/*categor*"
      ],
      "match": {
        "type": "regex",
        "pattern": "nslc|nspower|eastlink",
        "flags": "i"
      },
      "message": "Regional merchant rules belong in user-supplied rules, not shipped finance code."
    },
    {
      "id": "hardcoded-local-model",
      "kind": "operationalLiteral",
      "include": [
        "**/*"
      ],
      "exclude": [
        "crates/goose/src/config/model_roles.rs",
        "crates/goose/src/cost_router/knowledge.rs"
      ],
      "match": {
        "type": "regex",
        "pattern": "qwen2\\.5:|qwen3\\.8",
        "flags": ""
      },
      "message": "Resolve the local model from config; only the resolver modules may name one."
    }
  ],
  "exceptions": [
    {
      "id": "workspace-snapshot-dev-canon-example",
      "ruleId": "operational-home-root",
      "path": "crates/goose-server/src/automation/workspace_snapshot.yaml",
      "line": 35,
      "exactLine": "  **Yesterday you worked on:** [group modified files by parent directory, e.g., \"3 files in ~/dev/canon, 2 files in ~/Documents\"]",
      "contextBefore": [
        ""
      ],
      "contextAfter": [
        "",
        "  **Disk:** [X% full, Y GB free]"
      ],
      "matchedText": "~/dev",
      "expectedMatches": 1,
      "reasonCode": "illustrativeExample",
      "reason": "Template labels the path as an example in the report shape, not a configured root.",
      "reviewBy": "2026-12-22"
    },
    {
      "id": "terminal-reattach-label-example",
      "ruleId": "developer-places-projects",
      "path": "ui/command-center/src/components/terminal/terminalReattach.ts",
      "line": 104,
      "exactLine": "/** `~/Documents/dev/GetLadle` -> `GetLadle`. Falls back to the whole string. */",
      "contextBefore": [
        ""
      ],
      "contextAfter": [
        "export function labelForCwd(cwd: string): string {"
      ],
      "matchedText": "GetLadle",
      "expectedMatches": 2,
      "reasonCode": "illustrativeExample",
      "reason": "Doc-comment example path in a file whose bytes are hash-pinned by terminalChrome.test.ts (gate 6); editing it would force a re-freeze without a behaviour change.",
      "reviewBy": "2027-01-31"
    }
  ]
}
