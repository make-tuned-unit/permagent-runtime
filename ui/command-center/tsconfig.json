{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // The shared analytics client (ui/analytics-client) is typechecked as part
    // of this program — see "include" — but it has no node_modules of its own,
    // so bare specifiers in its tests resolve from here.
    "baseUrl": ".",
    "paths": {
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src", "../analytics-client/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}