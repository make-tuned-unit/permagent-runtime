          <button
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Explore World
            </span>
          </button>
        </div>
        <p
          style="margin: 16px 0px 0px; font-size: 13px; color: rgb(75, 85, 99);"
        >
          No runs or memories yet. Your activity will appear here as you work.
        </p>
      </section>
      <div
        class="pa-home-overview"
        data-testid="home-grid"
        style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: auto; grid-auto-flow: row; gap: 16px; user-select: auto;"
      />
      <div
        style="margin-top: 16px;"
      >
        <div
          aria-label="Learn next: getting started"
          data-testid="home-banner-learn-next"
          role="note"
          style="display: flex; align-items: center; gap: 18px; margin-bottom: 20px; padding: 14px 16px; border-radius: 14px; background: rgb(255, 255, 255); border: 1px solid rgba(0, 191, 239, 0.4); box-shadow: 0 2px 12px rgba(30,37,48,0.10), 0 1px 4px rgba(30,37,48,0.06); overflow: hidden;"
        >
          <div
            style="flex: 1 1 0%; min-width: 0;"
          >
            <div
              style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; font-size: 11px; letter-spacing: 0.14em; color: rgb(107, 117, 133); margin-bottom: 4px; display: flex; gap: 10px; align-items: center;"
            >
              <span>
                ✦ 
                LEARN NEXT
              </span>
            </div>
            <div
              style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(30, 37, 48); line-height: 1.4;"
            >
              World is ready to explore. Once you choose a model, your agent can guide you through the app.
            </div>
          </div>
          <div
            style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;"
          >
            <button
              aria-label="Dismiss this suggestion"
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 8px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #6B7585; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 0; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 400; width: 26px; height: 26px; font-size: 12px;"
              type="button"
            >
              <span
                class="pa-btn__label"
              >
                ✕
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
