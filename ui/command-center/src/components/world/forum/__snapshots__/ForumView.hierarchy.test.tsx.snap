    style="--forum-bg: #F8FAFC; --forum-panel: #FFFFFF; --forum-inset: #EEF2F7; --forum-text: #1E2530; --forum-muted: #4B5563; --forum-border: rgba(167,176,190,0.35); --forum-accent: #00BFEF; --forum-accent-soft: rgba(0,191,239,0.10); --forum-ink: #04141B; --forum-elevated: #F8FAFC; --forum-border-hi: rgba(0,191,239,0.40); --forum-ribbon: linear-gradient(135deg, #00BFEF 0%, #3A7BFF 30%, #8B5CFF 100%); --forum-success: #059669; --forum-warning: #D97706; --forum-danger: #DC2626; --forum-glass: rgba(255,255,255,0.9); --forum-blur: blur(24px) saturate(170%); --forum-shadow: inset 0 1px 0 rgba(255,255,255,0.90), inset 0 -1px 0 rgba(30,37,48,0.06), inset 0 0 0 1px rgba(167,176,190,0.35), 0 16px 48px rgba(30,37,48,0.12); --forum-color-scheme: light; --forum-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; --forum-display: "Manrope", "Satoshi", -apple-system, BlinkMacSystemFont, sans-serif; --forum-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; --forum-radius: 6px; --forum-space-xl: 12px; --forum-space-xxl: 16px; --forum-space-xxxl: 20px; --forum-space-huge: 24px; --forum-idle: #8A94A6; --forum-bronze: #A08555;"
  >
    <section
      aria-label="Interactive solarpunk forum"
      class="forum-world"
      data-hud="awake"
    >
      <div
        class="forum-lane forum-lane-left"
      >
        <header
          class="forum-brand"
        >
          <button
            aria-label="Hide the world title"
            class="pa-btn pa-btn--bare forum-card-dismiss"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              <span
                aria-hidden="true"
              >
                ×
              </span>
            </span>
          </button>
          <div>
            <div
              class="eyebrow"
            >
              PERMAGENT / WORLD
            </div>
            <h1
              style="font-size: 32px; line-height: 38px; font-weight: 600; letter-spacing: -0.02em;"
            >
              The Solar Forum
            </h1>
            <p>
              Living forum · 
              <span
                data-testid="forum-appearance"
              >
                Day
                 / 
                World lighting override
              </span>
            </p>
          </div>
        </header>
        <div
          class="forum-rail"
          data-open="closed"
        >
          <button
            aria-controls="forum-place-rail"
            aria-expanded="false"
            class="pa-btn forum-rail-handle"
            style="--pa-btn-fg: #1E2530;"
            type="button"
          >
            <span
              aria-hidden="true"
            >
              ›
            </span>
            <span
              class="forum-rail-handle-label"
            >
              Places
            </span>
          </button>
          <div
            aria-hidden="true"
            aria-label="World places"
            class="forum-rail-list"
            id="forum-place-rail"
            inert=""
            role="radiogroup"
          >
            <button
              aria-checked="true"
              class="pa-btn forum-rail-place"
              data-active="yes"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Arrival table
              </span>
              <span
                class="forum-rail-place-sub"
              >
                A place to begin
              </span>
            </button>
            <button
              aria-checked="false"
              class="pa-btn forum-rail-place"
              data-active="no"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Garden archive
              </span>
              <span
                class="forum-rail-place-sub"
              >
                Sources, stories & memory
              </span>
            </button>
            <button
              aria-checked="false"
              class="pa-btn forum-rail-place"
              data-active="no"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Maker workshop
              </span>
              <span
                class="forum-rail-place-sub"
              >
                See the work take shape
              </span>
            </button>
            <button
              aria-checked="false"
              class="pa-btn forum-rail-place"
              data-active="no"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Observatory
              </span>
              <span
                class="forum-rail-place-sub"
              >
                A wider view
              </span>
            </button>
            <button
              aria-checked="false"
              class="pa-btn forum-rail-place"
              data-active="no"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Observatory garden
              </span>
              <span
                class="forum-rail-place-sub"
              >
                Sky court & instrument plinth
              </span>
            </button>
            <button
              aria-checked="false"
              class="pa-btn forum-rail-place"
              data-active="no"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="forum-rail-place-name"
              >
                Conservatory
              </span>
              <span
                class="forum-rail-place-sub"
              >
                Cultivate & measure
              </span>
            </button>
          </div>
        </div>
        <div
          class="forum-location"
        >
          <button
            aria-label="Hide the place card"
            class="pa-btn pa-btn--bare forum-card-dismiss"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              <span
                aria-hidden="true"
              >
                ×
              </span>
            </span>
          </button>
          <span>
            ARRIVAL TABLE
          </span>
          <p>
            A place to begin
          </p>
        </div>
        <div
          class="forum-live"
        >
          <button
            aria-label="Hide the job feed"
            class="pa-btn pa-btn--bare forum-card-dismiss"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              <span
                aria-hidden="true"
              >
                ×
              </span>
            </span>
          </button>
          0 active jobs reported
          <small>
            Architecture preview · existing World agent feeds
          </small>
        </div>
        <div
          class="forum-controls"
        >
          <button
            aria-label="Hide the control hints"
            class="pa-btn pa-btn--bare forum-card-dismiss"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              <span
                aria-hidden="true"
              >
                ×
              </span>
            </span>
          </button>
          Drag to orbit · Scroll to explore · Select a place or walk from this place
        </div>
      </div>
      <div
        aria-label="Explore World"
        class="forum-lane forum-lane-right habitat-view-tools"
        role="group"
      >
        <button
          aria-pressed="false"
          class="pa-btn pa-btn--bare"
          style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
        >
          <span
            class="pa-btn__label"
          >
            Overview
          </span>
        </button>
        <div
          class="forum-appearance-control"
        >
          <button
            aria-controls=":rq:"
            aria-expanded="false"
            class="pa-btn pa-btn--bare"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              World appearance
            </span>
          </button>
          <p
            aria-live="polite"
            class="sr-only"
            data-testid="forum-lighting-status"
            role="status"
            style="margin: 0px; font-size: 11px; max-width: 220px;"
          >
            Day lighting applied.
          </p>
          <div
            aria-label="World appearance"
            class="forum-appearance-panel"
            hidden=""
            id=":rq:"
            role="dialog"
            style="padding: 12px; border-radius: 8px; background: rgb(255, 255, 255); border: 1px solid rgba(167, 176, 190, 0.35); box-shadow: 0 20px 52px rgba(30,37,48,0.17);"
          >
            <label
              style="display: block; font-size: 13px;"
            >
              World light
              <select
                aria-label="World lighting"
                style="width: 100%; margin-top: 6px;"
              >
                <option
                  value="system"
                >
                  System appearance
                </option>
                <option
                  value="day"
                >
                  Warm daylight
                </option>
                <option
                  value="night"
                >
                  Lantern night
                </option>
              </select>
            </label>
            <div
              style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px;"
            >
              <button
                class="pa-btn pa-btn--ghost"
                style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
              >
                <span
                  class="pa-btn__label"
                >
                  Previous campus
                </span>
              </button>
              <button
                class="pa-btn pa-btn--ghost"
                style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
              >
                <span
                  class="pa-btn__label"
                >
                  Done
                </span>
              </button>
            </div>
          </div>
        </div>
        <div
          class="forum-play"
        >
          <button
            class="pa-btn pa-btn--bare"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
          >
            <span
              class="pa-btn__label"
            >
              Walk the world
            </span>
          </button>
        </div>
        <button
          aria-controls="forum-agent-desk"
          aria-expanded="true"
          class="pa-btn pa-btn--ghostOn"
          style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #00BFEF; --pa-btn-border: #00BFEF; --pa-btn-bg-hover: rgba(0,191,239,0.10); --pa-btn-border-hover: #00BFEF; --pa-btn-bg-active: rgba(0,191,239,0.25); --pa-btn-pad: 6px 10px;"
        >
          <span
            class="pa-btn__label"
          >
            Agent desk
          </span>
        </button>
      </div>
    </section>
    <aside
      aria-hidden="false"
      aria-label="Agent learning and task desk"
      class="forum-panel"
      id="forum-agent-desk"
      style="display: flex; flex-direction: column; padding: 0px; overflow: hidden;"
    >
      <div
        class="agent-desk-header"
        style="position: sticky; top: 0px; flex-shrink: 0; margin: 0px; padding: 20px; background: rgb(255, 255, 255); border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
      >
        <h2>
          Agent desk
        </h2>
        <button
          aria-label="Close agent desk"
          class="pa-btn pa-btn--ghost"
          style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
        >
          <span
            class="pa-btn__label"
          >
            Close
          </span>
        </button>
      </div>
      <div
        class="agent-desk-body"
        style="flex: 1 1 0%; min-height: 0; overflow-y: auto; padding: 20px;"
      >
        <label
          class="agent-desk-chooser-label"
          for="forum-agent"
        >
          Collaborator
        </label>
        <select
          aria-label="Choose an agent"
          id="forum-agent"
        >
          <option
            value="henry"
          >
            Aster · Sovereign orchestrator
          </option>
          <option
            value="librarian"
          >
            The Librarian
          </option>
          <option
            value="reader"
          >
            The Reader
          </option>
          <option
            value="watcher"
          >
            The Watcher
          </option>
          <option
            value="steward"
          >
            The Steward
          </option>
          <option
            value="strix"
          >
            The Guard
          </option>
          <option
            value="financier"
          >
            The Financier
          </option>
          <option
            value="forecaster"
          >
            The Forecaster
          </option>
          <option
            value="council"
          >
            The Council
          </option>
          <option
            value="polybot"
          >
            The Trader
          </option>
          <option
            value="picker"
          >
            The Picker
          </option>
          <option
            value="growth_measurement"
          >
            The Grower
          </option>
        </select>
        <nav
          aria-label="Agent desk"
          class="forum-tabs"
        >
          <button
            aria-pressed="true"
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Meet
            </span>
          </button>
          <button
            aria-pressed="false"
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Learn
            </span>
          </button>
          <button
            aria-pressed="false"
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Evidence
            </span>
          </button>
          <button
            aria-pressed="false"
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Brief
            </span>
          </button>
          <button
            aria-pressed="false"
            class="pa-btn pa-btn--ghost"
            style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
          >
            <span
              class="pa-btn__label"
            >
              Chat
            </span>
          </button>
        </nav>
        <section
          aria-label="Aster profile"
          class="agent-desk-profile"
          style="--agent-trim: #F0E6D0;"
        >
          <div
            class="agent-desk-profile-heading"
          >
            <div
              class="agent-desk-portrait-frame"
            />
            <div
              class="agent-desk-profile-identity"
            >
              <span
                class="agent-desk-role"
              >
                Sovereign orchestrator
              </span>
              <h3>
                Aster
              </h3>
              <p
                class="agent-desk-reported"
                role="status"
              >
                <span
                  aria-hidden="true"
                />
                Reported: 
                not yet available
              </p>
            </div>
          </div>
          <div
            aria-label="Conversation and briefs"
            class="agent-desk-primary-actions"
            role="group"
          >
            <button
              class="pa-btn pa-btn--primary"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: #00BFEF; --pa-btn-fg: #04141B; --pa-btn-border: transparent; --pa-btn-bg-hover: #00BFEF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #00BFEF; --pa-btn-pad: 7px 12px; --pa-btn-weight: 600;"
            >
              <span
                class="pa-btn__label"
              >
                Chat 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
            <button
              aria-label="Sit with Aster"
              class="pa-btn pa-btn--ghost"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
            >
              <span
                class="pa-btn__label"
              >
                Sit together
              </span>
            </button>
            <button
              class="pa-btn pa-btn--ghost"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
            >
              <span
                class="pa-btn__label"
              >
                Write a brief
              </span>
            </button>
          </div>
          <p
            class="agent-desk-chat-context"
          >
            Chat continues your shared conversation.
          </p>
          <div
            class="agent-desk-question"
          >
            <span
              class="eyebrow"
            >
              START WITH A QUESTION
            </span>
            <p
              class="agent-desk-suggested-question"
            >
              “
              Help me turn this idea into a clear plan and identify which agents should contribute.
              ”
            </p>
            <button
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
            >
              <span
                class="pa-btn__label"
              >
                Try a question for this role 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
          </div>
          <details
            class="agent-desk-disclosure"
          >
            <summary>
              Role & working style
            </summary>
            <p>
              Your sovereign orchestrator — the leader you name. Discuss an outcome, clarify the scope, and decide which specialist should help.
            </p>
            <p>
              Calm, attentive and decisive. Finds the real outcome behind a request, then brings the right collaborators together.
            </p>
            <blockquote>
              Warm and direct. Clarify the outcome; explain tradeoffs without grandstanding.
            </blockquote>
            <p>
              This agent has a daemon event source. Its presence alone does not confirm a connection or a running job.
            </p>
            <button
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
            >
              <span
                class="pa-btn__label"
              >
                How agents work ↗
              </span>
            </button>
          </details>
          <details
            class="agent-desk-disclosure"
          >
            <summary>
              Identity & passport 
              <span>
                Optional
              </span>
            </summary>
          </details>
        </section>
        <div
          class="agent-desk-support"
        >
          <details
            class="agent-desk-disclosure"
          >
            <summary>
              Work in flight 
              <span>
                0 active
              </span>
            </summary>
            <section
              class="forum-work"
            >
              <div
