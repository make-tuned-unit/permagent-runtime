            class="agent-desk-primary-actions"
            role="group"
          >
            <button
              class="pa-btn pa-btn--primary"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: #00BFEF; --pa-btn-fg: #04141B; --pa-btn-border: transparent; --pa-btn-bg-hover: #00BFEF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #00BFEF; --pa-btn-pad: 7px 12px; --pa-btn-weight: 600;"
            >
              <span
                class="pa-btn__label"
              >
                Chat 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
            <button
              aria-label="Sit with Aster"
              class="pa-btn pa-btn--ghost"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
            >
              <span
                class="pa-btn__label"
              >
                Sit together
              </span>
            </button>
            <button
              class="pa-btn pa-btn--ghost"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
            >
              <span
                class="pa-btn__label"
              >
                Write a brief
              </span>
            </button>
          </div>
          <p
            class="agent-desk-chat-context"
          >
            Chat continues your shared conversation.
          </p>
          <div
            class="agent-desk-question"
          >
            <span
              class="eyebrow"
            >
              START WITH A QUESTION
            </span>
            <p
              class="agent-desk-suggested-question"
            >
              “
              Help me turn this idea into a clear plan and identify which agents should contribute.
              ”
            </p>
            <button
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
            >
              <span
                class="pa-btn__label"
              >
                Try a question for this role 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
          </div>
          <details
            class="agent-desk-disclosure"
          >
            <summary>
              Role & working style
            </summary>
            <p>
              Your sovereign orchestrator — the leader you name. Discuss an outcome, clarify the scope, and decide which specialist should help.
            </p>
            <p>
              Calm, attentive and decisive. Finds the real outcome behind a request, then brings the right collaborators together.
            </p>
            <blockquote>
              Warm and direct. Clarify the outcome; explain tradeoffs without grandstanding.
            </blockquote>
            <p>
              This agent has a daemon event source. Its presence alone does not confirm a connection or a running job.
            </p>
            <button
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 2px 5px;"
            >
              <span
                class="pa-btn__label"
              >
                How agents work ↗
              </span>
            </button>
          </details>
          <details
            class="agent-desk-disclosure"
          >
            <summary>
              Identity & passport 
              <span>
                Optional
              </span>
            </summary>
          </details>
        </section>
        <div
          class="agent-desk-support"
        >
          <details
            class="agent-desk-disclosure"
          >
            <summary>
