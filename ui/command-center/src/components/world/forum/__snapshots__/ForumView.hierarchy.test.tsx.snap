                </option>
                <option
                  value="forecaster"
                >
                  The Forecaster
                </option>
                <option
                  value="council"
                >
                  The Council
                </option>
                <option
                  value="polybot"
                >
                  The Trader
                </option>
                <option
                  value="picker"
                >
                  The Picker
                </option>
                <option
                  value="growth_measurement"
                >
                  The Grower
                </option>
              </select>
            </div>
            <button
              class="pa-btn pa-btn--bare habitat-subtle"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 4px;"
            >
              <span
                class="pa-btn__label"
              >
                Details 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
          </div>
          <div
            class="habitat-agent-status"
          >
            <span
              class=""
            />
            <b>
              No live work reported
            </b>
            <span
              class="habitat-station"
            >
              The commons
            </span>
          </div>
          <div
            class="habitat-agent-actions"
          >
            <button
              class="pa-btn pa-btn--ghost habitat-sit"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #00BFEF; --pa-btn-border: rgba(0,191,239,0.40); --pa-btn-bg-hover: rgba(0,191,239,0.10); --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 5px 8px;"
            >
              <span
                class="pa-btn__label"
              >
                Sit with 
                Aster
                 
                <span
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </button>
            <button
              class="pa-btn pa-btn--ghost"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 5px 8px;"
            >
              <span
                class="pa-btn__label"
              >
                Give a brief
              </span>
            </button>
          </div>
          <div
            class="habitat-agent-utilities"
          >
            <button
              aria-controls="habitat-movement"
              aria-expanded="false"
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 5px 8px;"
            >
              <span
                class="pa-btn__label"
              >
                Movement 
                <span
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </button>
            <button
              aria-controls="habitat-work-feed"
              aria-expanded="false"
              class="pa-btn pa-btn--bare"
              style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 5px 8px;"
            >
              <span
