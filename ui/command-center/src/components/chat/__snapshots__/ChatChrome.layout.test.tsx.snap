                  style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; color: rgb(255, 255, 255); background-color: rgb(30, 36, 51); border: 1px solid rgba(255, 255, 255, 0.07);"
                >
                  <svg
