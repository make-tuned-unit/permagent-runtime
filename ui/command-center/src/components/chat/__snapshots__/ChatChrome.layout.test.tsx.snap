                  </span>
                  <button
                    aria-label="Remove notes.txt"
                    class="pa-btn pa-btn--bare shrink-0 ml-0.5"
                    style="--pa-btn-radius: 6px; --pa-btn-success: #34D399; --pa-btn-bg: transparent; --pa-btn-fg: #8A94A6; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #1E2433; --pa-btn-pad: 0; --pa-btn-fg-hover: #FFB4A2;"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="12"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
