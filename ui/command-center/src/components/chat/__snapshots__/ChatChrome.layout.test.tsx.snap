    style="position: relative; width: 320px; flex-shrink: 0; height: 100%; overflow: hidden; transition: none;"
  >
    <div
      style="position: relative; width: 320px; height: 100%; display: flex; flex-direction: column; background: rgb(30, 36, 51); border-left: 1px solid rgba(255, 255, 255, 0.07);"
    >
      <div
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 16px 12px; min-height: 64px; box-sizing: border-box; border-bottom: 1px solid rgba(255, 255, 255, 0.07); flex-shrink: 0; background: rgb(30, 36, 51); position: relative; z-index: 1;"
      >
        <span
          style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; font-size: 10px; color: rgb(90, 100, 120); letter-spacing: 0.08em; text-transform: uppercase;"
