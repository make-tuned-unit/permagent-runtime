          style="--pa-btn-radius: 6px; --pa-btn-success: #34D399; --pa-btn-bg: transparent; --pa-btn-fg: #FFFFFF; --pa-btn-border: rgba(255,255,255,0.07); --pa-btn-bg-hover: #262D3F; --pa-btn-border-hover: rgba(0,213,255,0.18); --pa-btn-bg-active: #1E2433; --pa-btn-pad: 6px 10px;"
        >
          <span
            class="pa-btn__label"
          >
            <span
              style="display: inline-flex; align-items: center; gap: 4px;"
            >
