    style="position: relative; width: 384px; flex-shrink: 0; height: 100%; overflow: hidden; transition: none;"
  >
    <div
      style="position: relative; width: 384px; height: 100%; display: flex; flex-direction: column; background: rgb(255, 255, 255); border-left: 1px solid rgba(167, 176, 190, 0.35);"
    >
      <div
        aria-label="Resize the chat panel"
        aria-orientation="vertical"
        aria-valuemax="640"
        aria-valuemin="320"
        aria-valuenow="384"
        role="separator"
        style="position: absolute; left: 0px; top: 0px; bottom: 0px; width: 12px; cursor: col-resize; z-index: 2; display: flex; justify-content: flex-start; align-items: center; outline: none;"
        tabindex="0"
      >
        <div
          aria-hidden="true"
          data-dock-seam="true"
          style="width: 2px; height: 100%; border-radius: 999px; background: transparent; transition: none;"
        />
        <div
          aria-hidden="true"
          data-dock-grip="true"
          style="position: absolute; left: 4px; top: 50%; transform: translateY(-50%); width: 4px; height: 32px; border-radius: 999px; background: rgba(167, 176, 190, 0.35); transition: none;"
        />
      </div>
      <div
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 16px 12px; min-height: 64px; box-sizing: border-box; border-bottom: 1px solid rgba(167, 176, 190, 0.35); flex-shrink: 0; background: rgb(255, 255, 255); position: relative; z-index: 1;"
      >
        <span
          style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; font-size: 10px; color: rgb(107, 117, 133); letter-spacing: 0.08em; text-transform: uppercase;"
        >
          Chat
        </span>
        <div
          style="flex: 1 1 0%;"
        />
        <button
          aria-label="Speak replies aloud"
          class="pa-btn pa-btn--ghost"
          style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 0; --pa-btn-fg-hover: #1E2530; width: 28px; height: 28px;"
        >
          <span
            class="pa-btn__label"
          >
            <svg
              fill="none"
              height="14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
            >
              <polygon
                points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
              />
              <line
                x1="23"
                x2="17"
                y1="9"
                y2="15"
              />
              <line
                x1="17"
                x2="23"
                y1="9"
                y2="15"
              />
            </svg>
          </span>
        </button>
        <button
          aria-label="Close chat"
          class="pa-btn pa-btn--ghost"
          style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #1E2530; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 6px 10px;"
        >
          <span
            class="pa-btn__label"
          >
            <span
              style="display: inline-flex; align-items: center; gap: 4px;"
            >
              <svg
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <line
                  x1="18"
                  x2="6"
                  y1="6"
                  y2="18"
                />
                <line
                  x1="6"
                  x2="18"
                  y1="6"
                  y2="18"
                />
              </svg>
               Close
            </span>
          </span>
        </button>
      </div>
      <div
        style="flex: 1 1 0%; min-height: 0;"
      >
        <div
          class="relative h-full"
        >
          <div
            class="relative flex h-full flex-col"
            style="background-color: rgb(248, 250, 252);"
          >
            <div
              class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5"
              style="border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
            >
              <div
                data-testid="session-picker"
                style="position: relative; min-width: 0;"
              >
                <button
                  aria-expanded="false"
                  aria-label="Choose chat session"
                  class="pa-btn"
                  style="--pa-btn-fg: #1E2530; --pa-btn-fg-hover: #00BFEF; --pa-btn-bg-hover: transparent; --pa-btn-pad: 0; --pa-btn-weight: 600; display: flex; justify-content: flex-start; gap: 4px; max-width: 100%; font-size: 13px; line-height: 1.5; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;"
                  type="button"
                >
                  <span
                    style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;"
                  >
                    Agent
                  </span>
                  <svg
                    fill="none"
                    height="10"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    style="flex-shrink: 0;"
                    viewBox="0 0 24 24"
                    width="10"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <polyline
                      points="6 9 12 15 18 9"
                    />
                  </svg>
                </button>
              </div>
              <div>
                <div
                  class="relative"
                  data-testid="provider-model-picker"
                >
                  <button
                    aria-expanded="false"
                    aria-haspopup="dialog"
                    aria-label="Choose chat provider and model"
                    class="pa-btn w-full"
                    style="--pa-btn-fg: #1E2530; --pa-btn-bg: transparent; --pa-btn-bg-hover: #F8FAFC; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-pad: 0 10px; --pa-btn-radius: 8px; justify-content: space-between; gap: 8px; height: 26px; min-height: 0;"
                    type="button"
                  >
                    <span
                      class="truncate text-left flex items-baseline gap-2 min-w-0"
                    >
                      <span
                        class="truncate"
                        style="font-size: 12px; line-height: 16px; font-weight: 400; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;"
                      >
                        Change model
                      </span>
                    </span>
                    <svg
                      fill="none"
                      height="13"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      style="color: rgb(107, 117, 133); transition: transform 160ms;"
                      viewBox="0 0 24 24"
                      width="13"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <polyline
                        points="6 9 12 15 18 9"
                      />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <div
              class="flex min-h-0 flex-1 items-center justify-center overflow-y-auto p-4"
            >
              <section
                aria-label="Chat model setup"
                data-state="needs-model"
                data-testid="chat-setup-card"
                style="width: 100%; max-width: 420px; padding: 24px; border: 1px solid rgba(167, 176, 190, 0.35); border-radius: 12px; background: rgb(255, 255, 255); box-shadow: 0 2px 12px rgba(30,37,48,0.10), 0 1px 4px rgba(30,37,48,0.06); font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;"
              >
                <p
                  style="margin: 0px; color: rgb(75, 85, 99); font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; font-size: 11px; letter-spacing: 0.08em;"
                >
                  CHAT SETUP
                </p>
                <h2
                  style="margin: 8px 0px 6px; color: rgb(30, 37, 48); font-family: "Manrope", "Satoshi", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 20px; font-weight: 600; line-height: 1.25;"
                >
                  Choose a model for Chat
                </h2>
                <p
                  style="margin: 0px; color: rgb(75, 85, 99); font-size: 13px; line-height: 1.55;"
                >
                  Chat needs a selected model before it can reply. Choose a hosted provider and model, or set up a model on this Mac.
                </p>
                <div
                  class="flex flex-wrap items-center"
                  style="gap: 6px; margin-top: 16px;"
                >
                  <button
                    class="pa-btn pa-btn--primary"
                    style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: #00BFEF; --pa-btn-fg: #04141B; --pa-btn-border: transparent; --pa-btn-bg-hover: #00BFEF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #00BFEF; --pa-btn-pad: 7px 12px; --pa-btn-weight: 600;"
                    type="button"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      Open model setup
                    </span>
                  </button>
                </div>
                <p
                  style="margin: 10px 0px 0px; color: rgb(75, 85, 99); font-size: 12px; line-height: 1.5;"
                >
                  Settings → Models includes local models and a route to provider API keys. Opening setup does not send a message.
                </p>
              </section>
            </div>
            <div
              id="meeting-dock-slot"
              style="flex-shrink: 0; max-height: 45%; overflow-y: auto;"
            />
            <div
              class="p-3"
              style="border-top: 1px solid rgba(167, 176, 190, 0.35); background-color: rgb(255, 255, 255);"
            >
              <div
                class="flex flex-wrap gap-1.5 mb-2"
              >
                <div
                  class="flex items-center gap-1.5 rounded-md px-2 py-1 text-[11px] max-w-[200px]"
                  style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; color: rgb(30, 37, 48); background-color: rgb(255, 255, 255); border: 1px solid rgba(167, 176, 190, 0.35);"
                >
                  <svg
                    class="shrink-0"
                    fill="none"
                    height="12"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    style="color: rgb(75, 85, 99);"
                    viewBox="0 0 24 24"
                    width="12"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"
                    />
                    <polyline
                      points="13 2 13 9 20 9"
                    />
                  </svg>
                  <span
                    class="truncate"
                  >
                    notes.txt
                  </span>
                  <button
                    aria-label="Remove notes.txt"
                    class="pa-btn pa-btn--bare shrink-0 ml-0.5"
                    style="--pa-btn-radius: 6px; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 0; --pa-btn-fg-hover: #DC2626;"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="12"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="12"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <line
                          x1="18"
                          x2="6"
                          y1="6"
                          y2="18"
                        />
                        <line
                          x1="6"
                          x2="18"
                          y1="6"
                          y2="18"
                        />
                      </svg>
                    </span>
                  </button>
                </div>
              </div>
              <div
                class="flex items-end"
                style="gap: 8px;"
              >
                <span
                  style="display: inline-flex; outline: none;"
                  tabindex="0"
                >
                  <button
                    aria-label="Attach files"
                    class="pa-btn pa-btn--ghost"
                    style="--pa-btn-radius: 8px; --pa-btn-success: #059669; --pa-btn-bg: #EEF2F7; --pa-btn-fg: #4B5563; --pa-btn-border: rgba(167,176,190,0.35); --pa-btn-bg-hover: #F8FAFC; --pa-btn-border-hover: rgba(0,191,239,0.40); --pa-btn-bg-active: #FFFFFF; --pa-btn-pad: 0; --pa-btn-fg-hover: #1E2530; width: 36px; height: 36px; flex-shrink: 0;"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="13"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        style="display: block;"
                        viewBox="0 0 24 24"
                        width="13"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
                        />
                      </svg>
                    </span>
                  </button>
                </span>
                <input
                  class="hidden"
                  multiple=""
                  type="file"
                />
                <div
                  style="position: relative; flex: 1 1 0%; min-width: 0; display: flex;"
                >
                  <textarea
                    aria-label="Message Agent"
                    class="flex-1 resize-none rounded-lg px-3 py-2 text-[14px] outline-none transition disabled:opacity-40"
                    rows="1"
                    style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; color: rgb(30, 37, 48); background-color: rgb(238, 242, 247); border: 1px solid rgba(167, 176, 190, 0.35); caret-color: #00BFEF; min-height: 36px; max-height: 120px; transition: border-color 150ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 150ms cubic-bezier(0.22, 1, 0.36, 1); height: 0px;"
                  >
                    Keep my unsent draft
                  </textarea>
                </div>
                <span
                  style="display: inline-flex; outline: none;"
                  tabindex="0"
                >
                  <button
                    aria-label="Send message"
                    class="pa-btn pa-btn--primary"
                    style="--pa-btn-radius: 8px; --pa-btn-success: #059669; --pa-btn-bg: #00BFEF; --pa-btn-fg: #04141B; --pa-btn-border: transparent; --pa-btn-bg-hover: #00BFEF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: rgba(0,191,239,0.25); --pa-btn-pad: 0; --pa-btn-weight: 600; --pa-btn-fg-hover: #04141B; width: 36px; height: 36px; flex-shrink: 0; gap: 0; box-shadow: 0 0 10px rgba(0,191,239,0.10); transition: background 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1);"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        style="display: block; transform: translateX(-0.5px);"
                        viewBox="0 0 24 24"
                        width="14"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <line
                          x1="22"
                          x2="11"
                          y1="2"
                          y2="13"
                        />
                        <polygon
                          points="22 2 15 22 11 13 2 9 22 2"
                        />
                      </svg>
                    </span>
                  </button>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
