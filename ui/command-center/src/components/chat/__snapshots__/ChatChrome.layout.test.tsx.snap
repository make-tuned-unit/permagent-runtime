  <div
    data-compact="true"
    data-testid="chat-dock"
    style="position: relative; width: 320px; flex-shrink: 0; height: 100%; overflow: hidden; transition: none;"
  >
    <div
      style="position: relative; width: 320px; height: 100%; display: flex; flex-direction: column; background: rgb(255, 255, 255); border-left: 1px solid rgba(167, 176, 190, 0.35);"
    >
      <div
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 16px 12px; min-height: 64px; box-sizing: border-box; border-bottom: 1px solid rgba(167, 176, 190, 0.35); flex-shrink: 0; background: rgb(255, 255, 255); position: relative; z-index: 1;"
      >
        <span
          style="font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; font-size: 10px; color: rgb(107, 117, 133); letter-spacing: 0.08em; text-transform: uppercase;"
        >
          Chat
        </span>
        <div
          style="flex: 1 1 0%;"
        />
        <button
          aria-label="Speak replies aloud"
