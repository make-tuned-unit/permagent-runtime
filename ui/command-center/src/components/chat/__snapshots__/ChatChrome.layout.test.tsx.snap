                          y1="6"
                          y2="18"
                        />
                        <line
                          x1="6"
                          x2="18"
                          y1="6"
                          y2="18"
                        />
                      </svg>
                    </span>
                  </button>
                </div>
              </div>
              <div
                class="flex items-end"
                style="gap: 8px;"
              >
                <span
                  style="display: inline-flex; outline: none;"
                  tabindex="0"
                >
                  <button
                    aria-label="Attach files"
                    class="pa-btn pa-btn--ghost"
                    style="--pa-btn-radius: 8px; --pa-btn-success: #34D399; --pa-btn-bg: #1E2433; --pa-btn-fg: #8A94A6; --pa-btn-border: rgba(255,255,255,0.07); --pa-btn-bg-hover: #262D3F; --pa-btn-border-hover: rgba(0,213,255,0.18); --pa-btn-bg-active: #1E2433; --pa-btn-pad: 0; --pa-btn-fg-hover: #FFFFFF; width: 36px; height: 36px; flex-shrink: 0;"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="13"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        style="display: block;"
                        viewBox="0 0 24 24"
                        width="13"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
                        />
                      </svg>
                    </span>
                  </button>
                </span>
                <input
                  class="hidden"
                  multiple=""
                  type="file"
                />
                <div
                  style="position: relative; flex: 1 1 0%; min-width: 0; display: flex;"
                >
                  <textarea
                    aria-label="Message Agent"
                    class="flex-1 resize-none rounded-lg px-3 py-2 text-[14px] outline-none transition disabled:opacity-40"
                    rows="1"
                    style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; color: rgb(255, 255, 255); background-color: rgb(30, 36, 51); border: 1px solid rgba(255, 255, 255, 0.07); caret-color: #00D5FF; min-height: 36px; max-height: 120px; transition: border-color 150ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 150ms cubic-bezier(0.22, 1, 0.36, 1); height: 0px;"
                  >
                    Keep my unsent draft
                  </textarea>
                </div>
                <span
                  style="display: inline-flex; outline: none;"
                  tabindex="0"
                >
                  <button
                    aria-label="Send message"
                    class="pa-btn pa-btn--primary"
                    style="--pa-btn-radius: 8px; --pa-btn-success: #34D399; --pa-btn-bg: #00D5FF; --pa-btn-fg: #04141B; --pa-btn-border: transparent; --pa-btn-bg-hover: #00D5FF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: rgba(0,213,255,0.45); --pa-btn-pad: 0; --pa-btn-weight: 600; --pa-btn-fg-hover: #04141B; width: 36px; height: 36px; flex-shrink: 0; gap: 0; box-shadow: 0 0 10px rgba(0,213,255,0.14); transition: background 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1);"
                  >
                    <span
                      class="pa-btn__label"
                    >
                      <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        style="display: block; transform: translateX(-0.5px);"
                        viewBox="0 0 24 24"
                        width="14"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <line
                          x1="22"
                          x2="11"
                          y1="2"
                          y2="13"
                        />
                        <polygon
                          points="22 2 15 22 11 13 2 9 22 2"
                        />
                      </svg>
                    </span>
                  </button>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

