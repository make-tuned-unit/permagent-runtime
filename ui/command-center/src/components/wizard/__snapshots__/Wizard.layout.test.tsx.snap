exports[`DOM Wizard model failed 1024x640 dark 1`] = `
<div
  style="width: 1024px; height: 640px;"
>
  <form
    novalidate=""
    style="display: flex; flex-direction: column; height: 100%; min-height: 0;"
  >
    <div
      style="flex: 1 1 0%; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; padding: 12px 24px;"
    >
      <div
        style="margin: auto; width: 100%; max-width: 680px; padding-top: 8px; padding-bottom: 24px;"
      >
        <h1
          data-step-heading=""
          style="font-family: "Manrope", "Satoshi", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 32px; line-height: 38px; font-weight: 600; letter-spacing: -0.02em; color: rgb(255, 255, 255); margin: 0px; text-align: center; outline: none;"
          tabindex="-1"
        >
          Choose a model
        </h1>
        <p
          style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; line-height: 1.55; color: rgb(138, 148, 166); margin: 8px auto 0px; text-align: center; max-width: 460px;"
        >
          Permagent needs a language model to think with. Use a hosted provider with an API key, or run one on this Mac.
        </p>
        <div
          style="margin-top: 24px; display: flex; flex-direction: column; gap: 12px;"
        >
          <div
            aria-label="How your agent thinks"
            role="radiogroup"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px;"
          >
            <label
              data-choice-focus="true"
              data-choice-selected="false"
              style="display: flex; gap: 10px; align-items: flex-start; cursor: pointer; padding: 12px 12px; border-radius: 12px; background: rgb(30, 36, 51); border: 1px solid rgba(255, 255, 255, 0.07); box-shadow: 0 0 0 2px #0B1220, 0 0 0 4px #FFFFFF; transition: none;"
            >
              <input
                data-autofocus=""
                name="model-choice"
                style="accent-color: #00D5FF; margin-top: 4px; flex-shrink: 0; outline: none;"
                type="radio"
                value="hosted"
              />
              <span
                style="display: flex; flex-direction: column; gap: 2px;"
              >
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; font-weight: 600; color: rgb(255, 255, 255);"
                >
                  Hosted provider
                </span>
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(138, 148, 166); line-height: 1.45;"
                >
                  Runs on the provider's servers. Needs an API key; provider usage charges may apply.
                </span>
                <span
                  style="font-size: 12px; color: rgb(138, 148, 166); min-height: 2.9em; line-height: 1.45; margin-top: 6px;"
                >
                  Internet connection required
                </span>
              </span>
            </label>
            <label
              data-choice-focus="false"
              data-choice-selected="false"
              style="display: flex; gap: 10px; align-items: flex-start; cursor: not-allowed; padding: 12px 12px; border-radius: 12px; background: rgb(30, 36, 51); border: 1px solid rgba(255, 255, 255, 0.07); box-shadow: none; transition: none;"
            >
              <input
                disabled=""
                name="model-choice"
                style="accent-color: #00D5FF; margin-top: 4px; flex-shrink: 0; outline: none;"
                type="radio"
                value="local"
              />
              <span
                style="display: flex; flex-direction: column; gap: 2px;"
              >
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; font-weight: 600; color: rgb(255, 255, 255);"
                >
                  On this Mac
                </span>
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(138, 148, 166); line-height: 1.45;"
                >
                  Runs locally through Ollama. Uses this Mac's memory and disk space.
                </span>
                <span
                  style="font-size: 12px; color: rgb(138, 148, 166); min-height: 2.9em; line-height: 1.45; margin-top: 6px;"
                >
                  Availability could not be checked
                </span>
              </span>
            </label>
            <label
              data-choice-focus="false"
              data-choice-selected="false"
              style="display: flex; gap: 10px; align-items: flex-start; cursor: pointer; padding: 12px 12px; border-radius: 12px; background: rgb(30, 36, 51); border: 1px solid rgba(255, 255, 255, 0.07); box-shadow: none; transition: none;"
            >
              <input
                name="model-choice"
                style="accent-color: #00D5FF; margin-top: 4px; flex-shrink: 0; outline: none;"
                type="radio"
                value="later"
              />
              <span
                style="display: flex; flex-direction: column; gap: 2px;"
              >
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; font-weight: 600; color: rgb(255, 255, 255);"
                >
                  Decide later
                </span>
                <span
                  style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(138, 148, 166); line-height: 1.45;"
                >
                  Look around first. Your agent can't reply until a model is connected.
                </span>
                <span
                  style="font-size: 12px; color: rgb(138, 148, 166); min-height: 2.9em; line-height: 1.45; margin-top: 6px;"
                >
                  Setup is optional
                </span>
              </span>
            </label>
          </div>
          <div
            data-testid="model-load-status"
            style="min-height: 48px;"
          >
            <div
              role="alert"
              style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5; color: rgb(255, 180, 162); display: flex; gap: 6px; align-items: flex-start;"
            >
              <span>
                Couldn't load the provider list (
                Provider list unavailable
                ).
                 
                <button
                  class="pa-btn pa-btn--bare"
                  style="--pa-btn-radius: 0; --pa-btn-success: #34D399; --pa-btn-bg: transparent; --pa-btn-fg: #8A94A6; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #FFFFFF; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                  type="button"
                >
                  <span
                    class="pa-btn__label"
                  >
                    Try again
                  </span>
                </button>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="wizard-action-footer"
      style="flex-shrink: 0; border-top: 1px solid rgba(255, 255, 255, 0.07); padding: 12px 24px;"
    >
      <div
        style="margin: 0px auto; max-width: 680px; display: flex; align-items: center; justify-content: space-between; gap: 12px;"
      >
        <div
          style="display: flex; align-items: center; gap: 8px; min-width: 0;"
        />
        <button
          class="pa-btn pa-btn--primary"
          disabled=""
          style="--pa-btn-radius: 8px; --pa-btn-success: #34D399; --pa-btn-bg: rgba(141,68,174,0.18); --pa-btn-fg: #5A6478; --pa-btn-border: transparent; --pa-btn-bg-hover: #A855CC; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #8D44AE; --pa-btn-pad: 10px 20px; --pa-btn-weight: 600; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; letter-spacing: -0.01em; min-height: 40px; min-width: 220px; width: auto; box-shadow: none; flex-shrink: 0;"
          type="submit"
        >
          <span
            class="pa-btn__label"
          >
            Continue
          </span>
        </button>
      </div>
    </div>
  </form>
</div>
