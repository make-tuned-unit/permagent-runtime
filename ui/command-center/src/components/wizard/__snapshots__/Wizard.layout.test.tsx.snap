          style="font-family: "Manrope", "Satoshi", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 32px; line-height: 38px; font-weight: 600; letter-spacing: -0.02em; color: rgb(30, 37, 48); margin: 0px; text-align: center; outline: none;"
          tabindex="-1"
        >
          Ready when you are
        </h1>
        <p
          style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; line-height: 1.55; color: rgb(75, 85, 99); margin: 8px auto 0px; text-align: center; max-width: 460px;"
        >
          Here's what's set up. Change anything now, or later in Settings.
        </p>
        <div
          style="margin-top: 24px; display: flex; flex-direction: column; gap: 12px;"
        >
          <div
            data-testid="review-check-status"
            style="min-height: 72px;"
          >
            <div
              role="status"
              style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5; color: rgb(217, 119, 6); display: flex; gap: 6px; align-items: flex-start;"
            >
              <span>
                No model is connected, so Aster can't reply yet. Add one any time in Settings → Models.
              </span>
            </div>
          </div>
          <dl
            style="margin: 0px; display: flex; flex-direction: column;"
          >
            <div
              style="display: grid; grid-template-columns: 128px 1fr auto; align-items: center; gap: 12px; padding: 8px 0px; border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
            >
              <dt
                style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(75, 85, 99);"
              >
                Model
              </dt>
              <dd
                style="margin: 0px; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(217, 119, 6); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
              >
                Not connected
              </dd>
              <button
                aria-label="Change model"
                class="pa-btn pa-btn--bare"
                style="--pa-btn-radius: 0; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                type="button"
              >
                <span
                  class="pa-btn__label"
                >
                  Change
                </span>
              </button>
            </div>
            <div
              style="display: grid; grid-template-columns: 128px 1fr auto; align-items: center; gap: 12px; padding: 8px 0px; border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
            >
              <dt
                style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(75, 85, 99);"
              >
                Agent
              </dt>
              <dd
                style="margin: 0px; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(30, 37, 48); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
              >
                Aster · Balanced
              </dd>
              <button
                aria-label="Change agent"
                class="pa-btn pa-btn--bare"
                style="--pa-btn-radius: 0; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                type="button"
              >
                <span
                  class="pa-btn__label"
                >
                  Change
                </span>
              </button>
            </div>
            <div
              style="display: grid; grid-template-columns: 128px 1fr auto; align-items: center; gap: 12px; padding: 8px 0px; border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
            >
              <dt
                style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(75, 85, 99);"
              >
                Code folders
              </dt>
              <dd
                style="margin: 0px; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(30, 37, 48); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
              >
                None
              </dd>
              <button
                aria-label="Change code folders"
                class="pa-btn pa-btn--bare"
                style="--pa-btn-radius: 0; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                type="button"
              >
                <span
                  class="pa-btn__label"
                >
                  Change
                </span>
              </button>
            </div>
            <div
              style="display: grid; grid-template-columns: 128px 1fr auto; align-items: center; gap: 12px; padding: 8px 0px; border-bottom: 1px solid rgba(167, 176, 190, 0.35);"
            >
              <dt
                style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(75, 85, 99);"
              >
                Web search
              </dt>
              <dd
                style="margin: 0px; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(30, 37, 48); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
              >
                Not set up
              </dd>
              <button
                aria-label="Change web search"
                class="pa-btn pa-btn--bare"
                style="--pa-btn-radius: 0; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                type="button"
              >
                <span
                  class="pa-btn__label"
                >
                  Change
                </span>
              </button>
            </div>
            <div
              style="display: grid; grid-template-columns: 128px 1fr auto; align-items: center; gap: 12px; padding: 8px 0px;"
            >
              <dt
                style="font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: rgb(75, 85, 99);"
              >
                Memory model
              </dt>
              <dd
                style="margin: 0px; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: rgb(30, 37, 48); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
              >
                Off
              </dd>
              <button
                aria-label="Change memory model"
                class="pa-btn pa-btn--bare"
                style="--pa-btn-radius: 0; --pa-btn-success: #059669; --pa-btn-bg: transparent; --pa-btn-fg: #4B5563; --pa-btn-border: transparent; --pa-btn-bg-hover: transparent; --pa-btn-border-hover: transparent; --pa-btn-bg-active: transparent; --pa-btn-pad: 6px 2px; --pa-btn-fg-hover: #1E2530; --pa-btn-weight: 500; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; line-height: 1.5;"
                type="button"
              >
                <span
                  class="pa-btn__label"
                >
                  Change
                </span>
              </button>
            </div>
          </dl>
          <div>
            <label
              for=":r6:"
              style="font-size: 11px; line-height: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; color: rgb(75, 85, 99); display: block; margin-bottom: 6px;"
            >
              First message (optional)
            </label>
            <textarea
              id=":r6:"
              placeholder="Anything you want to start with? It will be waiting in the chat for you to send."
              rows="2"
              spellcheck="true"
              style="width: 100%; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; font-weight: 400; color: rgb(30, 37, 48); background: rgb(238, 242, 247); resize: none; line-height: 1.55; border: 1px solid rgba(167, 176, 190, 0.35); border-radius: 8px; padding: 10px 12px; outline: none; box-shadow: none; transition: border-color 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1);"
            />
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="wizard-action-footer"
      style="flex-shrink: 0; border-top: 1px solid rgba(167, 176, 190, 0.35); padding: 12px 24px;"
    >
      <div
        style="margin: 0px auto; max-width: 560px; display: flex; align-items: center; justify-content: space-between; gap: 12px;"
      >
        <div
          style="display: flex; align-items: center; gap: 8px; min-width: 0;"
        />
        <button
          class="pa-btn pa-btn--primary"
          style="--pa-btn-radius: 8px; --pa-btn-success: #059669; --pa-btn-bg: #8B5CFF; --pa-btn-fg: #FFFFFF; --pa-btn-border: transparent; --pa-btn-bg-hover: #9B6FFF; --pa-btn-border-hover: transparent; --pa-btn-bg-active: #8B5CFF; --pa-btn-pad: 10px 20px; --pa-btn-weight: 600; font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; letter-spacing: -0.01em; min-height: 40px; min-width: 220px; width: auto; box-shadow: 0 4px 14px rgba(139,92,255,0.25); flex-shrink: 0;"
          type="submit"
        >
          <span
            class="pa-btn__label"
          >
            Start Permagent
          </span>
        </button>
      </div>
    </div>
  </form>
</div>
`;
