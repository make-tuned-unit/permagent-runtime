<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime entitlements. These only take effect once the bundle
	     is code-signed with the Apple Developer ID (notarization enables the
	     hardened runtime); an unsigned build ignores them. -->

	<!-- permagentd embeds V8 (pctx_code_mode → deno_core → v8): JIT pages and
	     rusty_v8's executable-memory mapping are killed by the hardened
	     runtime without these two. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- Push-to-talk dictation: the webview captures the mic (getUserMedia).
	     Under the hardened runtime, mic access needs this entitlement on top
	     of Info.plist's NSMicrophoneUsageDescription. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Video calls in the in-app browser need the camera under the hardened
	     runtime, on top of Info.plist's NSCameraUsageDescription. -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- Sending Apple events to another app (the Calendar card's `tell
	     application "Calendar"`) is blocked outright by the hardened runtime
	     without this, on top of Info.plist's NSAppleEventsUsageDescription.
	     See the long note in Info.plist for why the pair is necessary but not
	     sufficient: it only helps when the app spawned permagentd itself. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- EventKit calendar access (src/calendar.rs, the Calendar card's
	     "Connect Calendar" button). The hardened runtime denies calendar
	     data to a signed app without this, on top of Info.plist's
	     NSCalendarsFullAccessUsageDescription. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
