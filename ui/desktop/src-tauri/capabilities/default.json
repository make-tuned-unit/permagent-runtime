{
  "identifier": "default",
  "description": "Default permissions for Permagent desktop app",
  "windows": ["main", "chat"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-center",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
