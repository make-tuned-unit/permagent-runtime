{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Permagent",
  "version": "1.31.0",
  "identifier": "ai.permagent.desktop",
  "build": {
    "frontendDist": "../../command-center/dist",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "cd ../command-center && npm run build",
    "beforeDevCommand": "cd ../command-center && npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Permagent",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001 http://127.0.0.1:3001 ws://localhost:3001 ws://127.0.0.1:3001; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://rsms.me https://api.fontshare.com; font-src 'self' https://rsms.me https://api.fontshare.com; img-src 'self' data: blob: http://localhost:3001 http://127.0.0.1:3001; frame-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "externalBin": ["binaries/permagentd"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
